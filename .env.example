# ==============================================================================
# ONE VISION COMMUNITY — CONFIGURATION D'ENVIRONNEMENT (SASAPAY / SASPAY)
# ==============================================================================
# Renommez ce fichier en ".env" et renseignez vos clés réelles.
# Ce fichier ".env" est ignoré par Git pour des raisons de sécurité.

# 1. ENVIRONNEMENT : "production" ou "sandbox"
SASAPAY_ENV=production

# 2. IDENTIFIANTS DU COMPTE MARCHAND SASAPAY (PRODUCTION)
# Si votre compte utilise une clé API secrète (sk_live_...) :
SASAPAY_API_KEY=votre_cle_secrete_production_ici

# Si votre compte utilise un Client ID & Secret OAuth :
SASAPAY_CLIENT_ID=
SASAPAY_CLIENT_SECRET=
SASAPAY_MERCHANT_CODE=

# 3. SECRET DE SIGNATURE WEBHOOK (HMAC SHA-256)
# Obtenu lors de la création de votre webhook sur https://app.saspay.me
SASAPAY_WEBHOOK_SECRET=votre_secret_webhook_ici

# 4. URL PUBLIQUE DU SITE & CALLBACK IPN
# En production, mettez l'URL de votre nom de domaine réel (ex: https://onevision.community)
# En test local, vous pouvez utiliser un tunnel ngrok (ex: https://xyz.ngrok-free.app)
APP_URL=https://onevision.community
SASAPAY_CALLBACK_URL=https://onevision.community/webhook-saspay.php

# 5. PARAMÈTRES GÉNÉRAUX & ESSAI RÉEL
SASPAY_CURRENCY=EUR

# Pour tester en conditions réelles avec un petit montant (200 Francs CFA, seuil minimum réseau SasaPay) :
# Décommentez les 2 lignes ci-dessous. Pour repasser au tarif normal (9€ / 5 900 FCFA), effacez ou commentez la valeur.
SASAPAY_TEST_OVERRIDE_AMOUNT=200
SASAPAY_TEST_OVERRIDE_CURRENCY=XOF
